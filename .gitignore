# e2studio / Eclipse workspace metadata (large, machine-specific)
.metadata/

# Build outputs (regenerated by e2studio)
Debug/
Release/
**/Debug/
**/Release/
*.o
*.d
*.su
*.map
*.srec
*.bin

# Temporary logs and scratch files
_tmp/
*.log

# e2studio local launch/config files (contain absolute paths)
*.launch
*.bak

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store

# Keep release firmware intentionally: put it under Firmware/ if needed.
# Build outputs under Debug/ are ignored above.
